# Root env consumed by docker-compose. Copy to `.env` and adjust as needed.
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace

DJANGO_SECRET_KEY=insecure-dev-key-change-me

# Transactional email via Resend (optional in dev). Leave RESEND_API_KEY empty
# to use Django's console backend, which prints verification links to the logs.
# EMAIL_NAME is the From address and must be a Resend-verified sender.
RESEND_API_KEY=
EMAIL_NAME=no-reply@marketplace.local

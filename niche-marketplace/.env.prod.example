# Production env for docker-compose.prod.yml. Copy to `.env.prod` on the box
# and fill in real secrets. Never commit the real .env.prod.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=marketplace.urbantrends.dev

# --- Database -------------------------------------------------------------
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-strong
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend (Vercel) ----------------------------------------------------
# Origin(s) allowed to call the API from the browser (comma-separated). Use the
# exact Vercel URL; add a custom domain later without code changes.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
# Admin/session POSTs on the API's own domain need this.
CSRF_TRUSTED_ORIGINS=https://marketplace.urbantrends.dev
# Verification links in emails point at the frontend, NOT the API.
FRONTEND_URL=https://your-project.vercel.app

# --- Email (Resend over SMTP) --------------------------------------------
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Marketplace <marketplace@urbantrends.dev>

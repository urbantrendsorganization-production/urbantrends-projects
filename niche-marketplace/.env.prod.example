# Production env for docker-compose.prod.yml. Copy to `.env.prod` on the box
# and fill in real secrets. Never commit the real .env.prod.
#
# Pass it with --env-file so compose can interpolate the deploy vars below as
# well as inject the app vars into the containers:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# --- Deploy (consumed by docker-compose.prod.yml itself) ------------------
# Image published by .github/workflows/niche-marketplace.yml.
GHCR_REPO=urbantrendsorganization-production/urbantrends-projects
# `main` follows the branch; pin to a commit SHA tag for reproducible rollbacks.
IMAGE_TAG=main
# Loopback port the host Caddy proxies to. 8086/8087 are onboardkit/keja.
API_PORT=8088
# Host path bind-mounted at /app/media; the host Caddy serves /media/* from it.
MEDIA_ROOT=/opt/marketplace/media

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# `localhost` is required by the api container's healthcheck, which probes
# http://localhost:8000 from inside the container. The port is loopback-only.
DJANGO_ALLOWED_HOSTS=marketplace.urbantrends.dev,localhost

# --- Database -------------------------------------------------------------
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-strong
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend (Vercel) ----------------------------------------------------
# Origin(s) allowed to call the API from the browser (comma-separated). Use the
# exact Vercel URL; add a custom domain later without code changes.
CORS_ALLOWED_ORIGINS=https://urbantrends-projects.vercel.app
# Admin/session POSTs on the API's own domain need this.
CSRF_TRUSTED_ORIGINS=https://marketplace.urbantrends.dev
# Verification links in emails point at the frontend, NOT the API.
FRONTEND_URL=https://urbantrends-projects.vercel.app

# --- Email (Resend over SMTP) --------------------------------------------
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Marketplace <marketplace@urbantrends.dev>

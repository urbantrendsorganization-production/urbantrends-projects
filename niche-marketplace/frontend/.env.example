# Base URL server components use to reach the backend API.
API_URL=http://localhost:8000
# Base URL the browser uses for client-side API calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (Vercel) ---------------------------------------------------
# On Vercel both point at the public backend domain (no compose network there):
#   API_URL=https://marketplace.urbantrends.dev
#   NEXT_PUBLIC_API_URL=https://marketplace.urbantrends.dev
#
# NEXT_PUBLIC_API_URL is REQUIRED for production builds — lib/config.ts throws
# rather than baking the localhost fallback into the client bundle. Note that
# NEXT_PUBLIC_* is inlined at BUILD time: changing it in Vercel does nothing to
# an existing deployment, so redeploy WITHOUT the build cache afterwards.

{
  "$comment": [
    "Single source of truth, hand-extracted from design/design_handoff_booknasi/BookNasi.dc.html.",
    "The export is inline-styled HTML with hardcoded hex; there was no machine-readable token file.",
    "",
    "Everything with \"host\": true can be overridden at runtime by a site embedding the widget.",
    "Everything else is BookNasi's own and is not part of the host contract.",
    "The invariants at the bottom are not variables at all — see CLAUDE.md §10."
  ],

  "color": {
    "clay-50":      { "value": "#F6E9E1", "use": "Accent tint: selected card fill, focus halo" },
    "clay-200":     { "value": "#E9BFA5", "use": "Avatar fill, dark-surface accent text" },
    "clay-400":     { "value": "#D97742", "use": "Charts only" },
    "clay-600":     { "value": "#C2521F", "use": "The accent. Primary buttons, selected state, active data bars", "host": true, "hostName": "accent" },
    "clay-700":     { "value": "#A34117", "use": "Pressed primary, accent text on tint", "host": true, "hostName": "accent-pressed" },
    "clay-900":     { "value": "#6E2A0E", "use": "Avatar text on clay-200" },

    "white":        { "value": "#FFFFFF", "use": "Cards, sheets, headers, primary surface", "host": true, "hostName": "surface" },
    "paper":        { "value": "#FBF7F3", "use": "Phone body background, table header rows, sunken panels", "host": true, "hostName": "canvas" },
    "line":         { "value": "#E8DFD6", "use": "Hairlines, dividers, disabled fills" },
    "line-strong":  { "value": "#D6C8BB", "use": "Default 1.5px borders on inputs, cards, chips", "host": true, "hostName": "border" },
    "track":        { "value": "#F1E7DE", "use": "Meter and progress-bar track. Undocumented in the original export; used 22 times." },

    "ink-45":       { "value": "#8E7C6E", "use": "Meta text, labels, placeholders. 4.6:1 on white" },
    "ink-70":       { "value": "#574A41", "use": "Body text" },
    "ink":          { "value": "#1F1712", "use": "Headings, primary text, dark buttons" },
    "ink-disabled": { "value": "#A2948A", "use": "Disabled button label on line" },

    "pay-600":      { "value": "#1E8E3E", "use": "M-Pesa green. Payment moment only" },
    "pay-700":      { "value": "#146C2F", "use": "Green text on tint, success toast fill" },
    "pay-50":       { "value": "#E6F2E8", "use": "Paid badge fill, refund panels" },
    "pay-dark":     { "value": "#3FBB63", "use": "Green on the dark STK screen" },

    "hold-600":     { "value": "#B26A00", "use": "Pending / held / timer" },
    "hold-700":     { "value": "#8A5200", "use": "Hold text on tint" },
    "hold-50":      { "value": "#FBEFD9", "use": "Held-slot panel fill" },

    "fail-600":     { "value": "#AF1B24", "use": "Failure, no-show, destructive" },
    "fail-700":     { "value": "#8E1219", "use": "Failure text on tint" },
    "fail-300":     { "value": "#E7A9A6", "use": "Destructive borders" },
    "fail-50":      { "value": "#FBE7E6", "use": "Failure panel and badge fill" },

    "info-600":     { "value": "#3D5A6C", "use": "Offline, neutral information" },
    "info-700":     { "value": "#2C4655", "use": "Offline text on tint" },
    "info-50":      { "value": "#E7EDF1", "use": "Offline panel fill" },

    "stk-bg":       { "value": "#0F2A18", "use": "The one inverted screen: STK waiting" }
  },

  "$excluded": {
    "canvas": {
      "value": "#EFE7DE",
      "why": "Design-canvas background. It is the colour behind the phone frames in the export, not a product surface. Excluded so nobody reaches for it."
    }
  },

  "font": {
    "display": { "value": "'Bricolage Grotesque', system-ui, sans-serif", "weights": [600, 700], "use": "Screen titles, section headings, avatar initials", "host": true, "hostName": "font-display" },
    "ui":      { "value": "'IBM Plex Sans', system-ui, sans-serif", "weights": [400, 500, 600, 700], "use": "All UI: lists, forms, labels, body", "host": true, "hostName": "font-ui" },
    "mono":    { "value": "'IBM Plex Mono', ui-monospace, monospace", "weights": [400, 500, 600], "use": "Money and times only, plus receipt and reference codes" }
  },

  "type": {
    "display":     { "size": "32px", "lineHeight": "36px", "tracking": "-0.02em", "family": "display", "weight": 700 },
    "display-sm":  { "size": "30px", "lineHeight": "34px", "tracking": "-0.02em", "family": "display", "weight": 700 },
    "title":       { "size": "22px", "lineHeight": "28px", "tracking": "-0.01em", "family": "display", "weight": 600 },
    "body-lg":     { "size": "17px", "lineHeight": "24px", "family": "ui", "weight": 400 },
    "body":        { "size": "15px", "lineHeight": "22px", "family": "ui", "weight": 400 },
    "body-sm":     { "size": "14px", "lineHeight": "1.55", "family": "ui", "weight": 400 },
    "label":       { "size": "13px", "lineHeight": "16px", "tracking": "0.06em", "family": "ui", "weight": 600, "transform": "uppercase" },
    "micro":       { "size": "11.5px", "lineHeight": "14px", "tracking": "0.08em", "family": "ui", "weight": 600, "transform": "uppercase" },
    "money":       { "size": "20px", "lineHeight": "24px", "family": "mono", "weight": 600, "numeric": "tabular-nums" }
  },

  "space": {
    "$comment": "Collapsed from the export's 13 steps: 9 folded into 10, 13 into 14. Nothing in the design depends on a one-pixel difference.",
    "1": "4px", "2": "6px", "3": "8px", "4": "10px", "5": "12px", "6": "14px",
    "7": "16px", "8": "18px", "9": "20px", "10": "22px", "11": "24px", "12": "28px",
    "gutter": "20px",
    "gutter-desktop": "24px"
  },

  "radius": {
    "$comment": "Collapsed from the export's overlapping ranges: 9/10/11 to 10, 13/14 to 14, 16-18 to 16, 20-22 to 20. Named by role rather than by number, because the host overrides one of them by name.",
    "chip":  "8px",
    "sm":    "10px",
    "md":    { "value": "12px", "use": "Buttons and inputs", "host": true, "hostName": "radius-md" },
    "card":  "14px",
    "panel": "16px",
    "sheet": "20px",
    "frame": "28px",
    "pill":  "999px"
  },

  "border": {
    "hairline":    { "width": "1px",   "color": "line",       "use": "Structural panels" },
    "interactive": { "width": "1.5px", "color": "line-strong", "use": "Inputs, cards, chips at rest" },
    "selected":    { "width": "2px",   "color": "clay-600",   "use": "Selected and focused" }
  },

  "shadow": {
    "$comment": "Cards are flat — border only. These are the only two shadows in the product.",
    "sheet": "0 -18px 40px -20px rgba(31, 23, 18, 0.4)",
    "fab":   "0 10px 24px -6px rgba(194, 82, 31, 0.6)",
    "focus": "0 0 0 4px #F6E9E1"
  },

  "target": {
    "$comment": "Heights, not paddings. See invariants — the 52px floor is not themeable.",
    "control":  "52px",
    "cta":      "56px",
    "cta-staff": "62px",
    "walkin-row": "64px",
    "text-button-min": "44px"
  },

  "motion": {
    "step":      { "duration": "200ms", "easing": "ease-out" },
    "sheet":     { "duration": "240ms", "easing": "ease-out" },
    "toast":     { "duration": "160ms", "easing": "ease-out", "dismissAfter": "4000ms" },
    "countdown": { "easing": "linear", "$comment": "No easing. A timer that eases is a timer that lies." }
  },

  "label": {
    "$comment": "Copy tokens, not CSS. A luxury salon host relabels 'deposit' as 'reservation fee'. The refund sentence may be translated or relabelled, never removed.",
    "deposit": { "value": "deposit", "host": true },
    "deposit-title-case": { "value": "Deposit", "host": true },
    "case": { "value": "none", "host": true, "hostName": "label-case", "$comment": "Host may set 'uppercase' with tracking" }
  },

  "invariants": {
    "$comment": "CLAUDE.md §10. These ship as constants, never as CSS custom properties, so a host stylesheet cannot reach them.",
    "minTargetHeightPx": 52,
    "walkInRowMinHeightPx": 64,
    "slotsPerRow": 3,
    "holdCountdownAlwaysVisible": true,
    "ussdFallback": "*334#"
  }
}

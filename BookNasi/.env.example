# Copy to .env and fill in. Nothing real belongs in this file — CLAUDE.md §11.
# Sandbox credentials are still credentials.

DJANGO_SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

DATABASE_URL=postgres://booknasi:booknasi@localhost:5432/booknasi
REDIS_URL=redis://localhost:6379/0

# Where the client's booking page lives. Goes into the one link in every SMS.
PUBLIC_BASE_URL=http://localhost:3000

# Safaricom Daraja — slice 6. Never commit these, sandbox or live.
#
# Since slice 13 this block is the **platform** account: the one a shop on
# `collects_via = platform` collects into, which is every shop that predates
# that migration. A shop with its own Paybill or Till carries its own
# credentials in the database instead, encrypted with MPESA_CREDENTIAL_KEYS
# below, and never touches these.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Paybill: the paybill number. Till: the *store / head office* number, which is
# not the till number and is what the password is derived from.
MPESA_SHORTCODE=
# https://sandbox.safaricom.co.ke for sandbox, https://api.safaricom.co.ke live.
# Defaults to sandbox in `base.py`; live is opt-in, like the client itself.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_TIMEOUT_SECONDS=20
# CustomerPayBillOnline (paybill, the default) or CustomerBuyGoodsOnline (till).
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Required only for CustomerBuyGoodsOnline. This is the number the client's
# money actually lands on; `MPESA_SHORTCODE` above stays the store number.
MPESA_TILL_NUMBER=
# Must end with the token below. Safaricom neither signs callbacks nor offers
# mutual TLS, so the secret path segment is the only thing standing between
# this endpoint and a forged "ResultCode: 0" that confirms a free booking.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# `payments.daraja.FakeDarajaClient` locally and in CI: a real implementation of
# the same two methods, so nothing has to be mocked. Point it at
# `payments.daraja.DarajaClient` where there are credentials.
MPESA_CLIENT=payments.daraja.FakeDarajaClient

# What encrypts a shop's own M-Pesa passkey and consumer secret in the database
# — slice 13. `id:key` pairs, newest first: the first encrypts, all of them
# decrypt, so rotating is "add a new one at the front" and nothing else.
# Dropping an old id orphans every row still sealed with it, which is why
# `Shop.mpesa_key_id` records which one was used.
#
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#   MPESA_CREDENTIAL_KEYS=2026a:<that key>
#
# Blank locally and in CI, where nothing real is stored. Production refuses to
# boot without it — see config/settings/prod.py, and core/secrets.py for why a
# missing key is a refusal to save rather than a fallback to plaintext.
MPESA_CREDENTIAL_KEYS=

# How long client data is kept after their last appointment — CLAUDE.md §9.
# A daily sweep scrubs name, number and notes past this, keeping the bookings.
# Shorten it for a stricter regulator; there is deliberately no way to switch it
# off, because "kept indefinitely" is the one answer the DPA does not allow.
CLIENT_RETENTION_MONTHS=24

# Payment timing — slice 6. Defaults are in config/settings/base.py; these are
# here because they are the knobs a live shortcode's behaviour may need turned.
# HOLD_GRACE_MINUTES is T_grace: how long a hold with an unanswered STK push
# survives past its TTL. It shrinks the slotLost population; it cannot be
# extended by a resend, because the ceiling is derived from hold_expires_at.
HOLD_GRACE_MINUTES=2
PAYMENT_QUERY_AFTER_SECONDS=90
PAYMENT_QUERY_MAX_ATTEMPTS=4
PAYMENT_SWEEP_BATCH=200
PAYMENT_ESCALATE_AFTER_HOURS=24
STK_RESEND_MAX=2
STK_RESEND_MIN_INTERVAL_SECONDS=45

# Messaging — slice 6 (confirmation) and slice 8 (reminders). SMS first,
# behind the provider interface. CLAUDE.md §12.
MESSAGE_PROVIDER=notifications.providers.ConsoleProvider
SMS_API_KEY=
SMS_SENDER_ID=BOOKNASI

# Production only
CSRF_TRUSTED_ORIGINS=
